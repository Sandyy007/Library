# ─────────────────────────────────────────────
# Library Management System — Environment Config
# Copy this file to .env and fill in real values.
# NEVER commit your .env file to source control.
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=library_management
DB_POOL_SIZE=30

# ── Authentication ────────────────────────────
# REQUIRED — generate a strong random secret (min 32 chars).
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=1h

# ── Server ────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ──────────────────────────────────────
# Comma-separated list of allowed browser origins.
# Leave empty for desktop-only usage.
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ORIGINS=

# ── Rate Limiting ─────────────────────────────
# Global API rate limit (production only)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Request Limits ────────────────────────────
JSON_BODY_LIMIT=2mb

# ── HTTPS / SSL ──────────────────────────────
# Set these to paths of your SSL certificate and key files to enable HTTPS.
# Leave empty to run plain HTTP (suitable for local/intranet only).
# SSL_KEY=./ssl/privkey.pem
# SSL_CERT=./ssl/fullchain.pem

# ── Logging ──────────────────────────────────
# Optional: log to a file instead of stdout
# LOG_FILE=../logs/access.log
