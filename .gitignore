# ─────────────────────────────────────────────
# Library Management System — root .gitignore
# ─────────────────────────────────────────────

# ── Secrets & environment ─────────────────────
.env
.env.*
!.env.example

# ── Node / Backend ────────────────────────────
node_modules/
backend/node_modules/
backend/server.log
backend/.env
backend/jest_result*.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Uploads (user data) ──────────────────────
backend/uploads/*
!backend/uploads/.gitkeep

# ── Flutter / Dart ────────────────────────────
flutter_app/.dart_tool/
flutter_app/.flutter-plugins-dependencies
flutter_app/build/
flutter_app/.packages
flutter_app/.pub-cache/
flutter_app/.pub/

# ── IDE / Editor ──────────────────────────────
.idea/
.vscode/
*.iml
*.ipr
*.iws
.atom/
*.swp
*.swo
*~

# ── OS generated ──────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Build artifacts ───────────────────────────
build/
dist/
*.exe
installer_output/*.exe

# ── Logs / temp ───────────────────────────────
*.log
*_log.txt
flutter_app/build_output*.txt
flutter_app/debug_log.txt
flutter_app/run_windows.log
temp_original.dart

